DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/connecta
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Choisir un mot de passe privé de 16 à 256 caractères. Ne jamais le mettre dans le frontend.
ADMIN_PASSWORD=
# Paiement uniquement en mode test. Ne jamais committer ces clés.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SITE_URL=http://localhost:3000
# Facultatif (développement) : autres origines exactes de la boutique vers lesquelles
# le client peut revenir après paiement, séparées par des virgules. L'en-tête Origin
# de la requête ne sert qu'à choisir dans cette liste ; sinon CHECKOUT_SITE_URL.
# Laisser vide en production : comportement inchangé.
# CHECKOUT_RETURN_ORIGINS=http://localhost:3000,https://votre-machine.tailnet.ts.net
CHECKOUT_RETURN_ORIGINS=

# Espace membre : Resend en production ; console uniquement pour les tests locaux.
MEMBER_EMAIL_MODE=resend
RESEND_API_KEY=
MEMBER_EMAIL_FROM=
# En local sans envoi réel : remplacer resend par console.

# Livraison (centimes). Hors production, des tarifs provisoires s'appliquent
# (FR 590, BE 990, CA 2490) et l'API les annonce comme provisoires.
# En production, chaque tarif doit être défini et SHIPPING_RATES_CONFIRMED=true,
# sinon les frais et le checkout restent indisponibles.
SHIPPING_FR_CENTS=
SHIPPING_BE_CENTS=
SHIPPING_CA_CENTS=
# Mettre false pour ne pas proposer une destination.
SHIPPING_BE_ENABLED=true
SHIPPING_CA_ENABLED=true
SHIPPING_RATES_CONFIRMED=false

# Photos produits : compte Cloudinary. Clés uniquement dans l'API NestJS, jamais dans le frontend.
# L'éditeur admin fonctionne pour les prix / descriptions sans ces valeurs ; l'import de photos
# sera disponible après création du compte et configuration de ces trois champs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
